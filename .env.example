# Optional. Without a key the app still works fully: it uses OpenStreetMap for
# discovery and simply shows no star ratings or photos.
#
# IMPORTANT: anything prefixed VITE_ is inlined into the built JavaScript. A key
# placed here is PUBLIC on any deployed build. That is acceptable ONLY if you
# also, in Google Cloud Console:
#   1. restrict the key by HTTP referrer to your own domain, and
#   2. restrict it to the "Places API (New)" only.
# The app shows you the exact referrer strings to paste during setup.
VITE_GOOGLE_MAPS_API_KEY=

# Overpass mirrors, comma separated. The first that answers wins.
VITE_OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Soft monthly cap on Google calls. At the cap, enrichment disables itself and
# the app continues on OpenStreetMap data alone.
VITE_ENRICH_MONTHLY_CAP=2000

# "live" or "mock". Mock returns deterministic synthetic ratings so the UI can
# be developed and demoed with zero API spend.
VITE_ENRICH_MODE=live
